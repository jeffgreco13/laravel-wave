{
    "name": "jeffgreco13/laravel-wave",
    "description": "A wrapper to use the Wave GraphQL API in your Laravel apps.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Jeff Greco",
            "email": "jeff@jeffpgreco.com"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Jeffgreco13\\Wave\\": "src/"
        }
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Jeffgreco13\\Wave\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jeffgreco13\\Wave\\WaveServiceProvider"
            ],
            "aliases": {
                "WaveService": "Jeffgreco13\\Wave\\WaveService"
            }
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.3",
        "orchestra/testbench": "^10.0",
        "laravel/pint": "^1.26"
    }
}
